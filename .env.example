# Bybit Sniper Bot v2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Bybit API (read-only market data key) ────────────────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── OpenRouter API Keys (free tier, 3-key rotation) ──────────────────────────
OPENROUTER_KEY_1=your_openrouter_key_1_here
OPENROUTER_KEY_2=your_openrouter_key_2_here
OPENROUTER_KEY_3=your_openrouter_key_3_here
